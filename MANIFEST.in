include .gitignore AGENTS.md ARCH.md CONTRIBUTING.md LICENSE Makefile README.md
include pyproject.toml uv.lock
include .npmrc package.json package-lock.json
include plugin/plugin.json plugin/.claude-plugin/plugin.json plugin/LICENSE
recursive-include src *.py
recursive-include devtools *.py *.md
recursive-include plugin/skills/cloudflare-publish *.md *.yaml *.sh *.svg *.png
recursive-include tests *.py
recursive-include typings *.pyi
global-exclude *.py[cod] .DS_Store
prune .codex
prune .claude
prune .venv
prune node_modules
prune .pytest_cache
prune .ruff_cache
prune .basedpyright
