include .gitignore AGENTS.md ARCH.md CONTRIBUTING.md LICENSE Makefile README.md
include plugin.json pyproject.toml uv.lock
include .claude-plugin/plugin.json
include bin/cloudflare-publish
recursive-include src *.py
recursive-include devtools *.py *.md
recursive-include skills/cloudflare-publish *.md *.yaml *.sh *.svg *.png
recursive-include tests *.py
recursive-include typings *.pyi
global-exclude *.py[cod] .DS_Store
prune .codex
prune .claude
prune .venv
prune .pytest_cache
prune .ruff_cache
prune .basedpyright
